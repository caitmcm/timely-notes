# The E2E lanes' build (`--mode e2e`): always signed in with a fixed token, never redirected.
# The build guard in vite.config.ts refuses VITE_AUTH_MODE=static in a production build.
VITE_AUTH_MODE=static
# The stubbed lane's token; the integrated lane overrides it with one minted by dotnet user-jwts.
VITE_AUTH_STATIC_TOKEN=e2e-stubbed-token
